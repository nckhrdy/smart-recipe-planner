# Supabase config (ADR-0005). Copy this file to `.env` and fill from your
# Supabase project: Settings → API.
#
# EXPO_PUBLIC_* values are inlined into the app bundle. The anon key is SAFE to
# expose — every table is guarded by Row-Level Security. NEVER put the
# service_role key or the Anthropic API key here; those live only in the Edge
# Function as secrets.
EXPO_PUBLIC_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...) — Supabase's new name for the anon
# key. Safe in the client (RLS-guarded). NOT the secret key (sb_secret_...).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dev only: skip the Google sign-in wall while the DB is configured but OAuth
# isn't wired yet. Keep "true" during setup; set to "false" / remove once Google
# sign-in works. Must never be true in a real build.
EXPO_PUBLIC_DEV_BYPASS_AUTH=true
